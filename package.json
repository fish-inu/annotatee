{
  "name": "annotatee",
  "version": "1.0.0",
  "description": "A Chrome extension for annotating readable article text.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && npm run build:extension-scripts",
    "build:extension-scripts": "rolldown --config rolldown.config.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --experimental-strip-types --test tests/markdown.test.mjs tests/settings.test.mjs"
  },
  "keywords": [
    "annotation",
    "vue",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@recogito/text-annotator": "^4.2.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5"
  }
}
